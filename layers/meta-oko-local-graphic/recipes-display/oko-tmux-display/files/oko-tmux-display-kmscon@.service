[Unit]
Description=OKO tmux local display (kmscon) mirror on %I
Requires=oko-tmux-app.service
After=oko-tmux-app.service dev-%i.device
PartOf=oko-tmux-app.service
Conflicts=getty@%i.service
ConditionPathExists=/dev/%I

[Service]
Type=simple

ExecStart=/usr/bin/kmscon --no-use-original-mode --mode=1920x1080 --vt=%I --switchvt --oneshot --login -- /usr/bin/tmux -S /run/oko-tmux-display/tmux.sock attach-session -t oko-main

Restart=on-failure
RestartSec=2

StandardInput=tty-force
StandardOutput=tty
StandardError=journal

TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Environment=TERM=linux
Environment=LANG=en_US.UTF-8

[Install]
WantedBy=multi-user.target

