part /boot --source bootimg_biosplusefi --sourceparams="loader=grub-efi,loader-bios=syslinux,title=OKO Installer" --ondisk sda --fstype=vfat --label OKO_BOOT --active --align 1024 --use-uuid --fsoptions="ro"
part / --source rootfs --ondisk sda --fstype=ext4 --label OKO_INSTALL --align 1024 --use-uuid
bootloader --ptable gpt --timeout=3 --append="ro rootwait roottimeout=30 rootfstype=ext4 console=tty0 console=ttyS0,115200n8"
