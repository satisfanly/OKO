[Unit]
Description=OKO Wetty browser terminal at /wetty/
After=network.target sshd.service
Wants=sshd.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=oko-web-terminal
WorkingDirectory=/var/lib/oko-web-terminal
ExecStart=/usr/bin/wetty --host 0.0.0.0 --port 3000 --base /wetty --force-ssh --ssh-host 127.0.0.1 --ssh-port 22 --ssh-auth password --known-hosts /dev/null --log-level warn
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
